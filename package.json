{
  "name": "my-evershop-app",
  "version": "0.1.6",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "scripts": {
    "setup": "evershop install",
    "start": "evershop start",
    "compile-theme": "npm run build --prefix themes/sample",
    "compile-extension": "npm run build --prefix extensions/sample",
    "compile-kinsta-extension": "npm run build --prefix extensions/kinsta-simple",
    "prebuild": "npm run compile-theme && npm run compile-extension && npm run compile-kinsta-extension",
    "build": "evershop build",
    "dev": "evershop dev",
    "create-admin": "node scripts/create-admin.js",
    "reset-admin": "node scripts/reset-admin-password.js",
    "setup-card-shipping": "node scripts/setup-card-shipping.js",
    "setup-product-type": "node scripts/setup-product-type-attribute.js",
    "add-card-option": "node scripts/add-card-option.js",
    "setup-complete-shipping": "node scripts/setup-complete-shipping.js",
    "setup-simple-shipping": "node scripts/setup-simple-shipping.js"
  },
  "dependencies": {
    "@apollo/client": "^4.2.3",
    "@aws-sdk/client-s3": "^3.894.0",
    "@aws-sdk/s3-request-presigner": "^3.894.0",
    "@evershop/evershop": "2.2.1",
    "dotenv": "^17.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@parcel/watcher": "2.5.1",
    "@types/config": "3.3.5",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.13",
    "execa": "9.6.0",
    "typescript": "5.9.2"
  }
}
